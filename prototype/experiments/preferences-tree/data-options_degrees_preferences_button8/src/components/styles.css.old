* { box-sizing: border-box; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #f8f9fa;
  margin: 0;
  padding: 20px;
  color: #333;
}

.container {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  padding: 32px;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}

h1 {
  text-align: center;
  margin-bottom: 32px;
  font-weight: 600;
}

.option-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px;
  border-radius: 12px;
  transition: background 0.2s;
  margin-bottom: 12px;
}

.option-row:hover {
  background: #f5f7fa;
}

.row-toggle {
  margin-top: 4px;
  width: 20px;
  height: 20px;
  cursor: pointer;
}

.options-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.radio-line {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 15px;
}

.full-row-label, .linked-data-label {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font-size: 15px;
  width: 100%;
  padding: 8px 0;
  flex-wrap: wrap;
}

.linked-data-label {
  font-size: 15px;
  color: #1a1a1a;
  justify-content: flex-start;
}

.degree-input-inline {
  /* Remove all box-like appearance */
  border: none;
  background: transparent;
  padding: 0;
  margin: 0;
  width: 2.5ch;           /* enough room for 2–3 digits */
  max-width: 60px;
  font: inherit;          /* crucial: inherit font from parent */
  font-weight: bold;      /* keep the bold look */
  text-align: center;

  /* Remove native appearance completely */
  -webkit-appearance: none;
  -moz-appearance: textfield;
  appearance: none;

  /* Optional: subtle bottom border or underline when focused */
  border-bottom: 2px solid transparent;
  transition: border-color 0.2s;
}

.degree-input-inline:focus {
  outline: none;
  border-bottom: 2px solid #007bff;
  background: rgba(0, 123, 255, 0.05);
  border-radius: 4px;
}

/* Remove spin buttons (ugly arrows) */
.degree-input-inline::-webkit-outer-spin-button,
.degree-input-inline::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.degree-input-inline[type=number] {
  -moz-appearance: textfield; /* Firefox */
}

.layout-inline {
  margin-left: 2rem;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
}

.layout-inline select {
  padding: 6px 12px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 14px;
}

.submit-btn {
  display: block;
  margin: 32px auto 0;
  padding: 12px 32px;
  font-size: 16px;
  background: #1976d2;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}

.submit-btn:hover {
  background: #1565c0;
}

.radio-line input[type="radio"]:checked + *,
.full-row-label input[type="checkbox"]:checked + * {
  font-weight: 600;
  color: #1976d2;
}