import { useState } from "react";
import "./styles.css";

export default function App() {
  const [selections, setSelections] = useState({
    dataVisualization: {
      enabled: true,
      value: "nodeLinkDiagram",
      layout: "Yifan Hu Proportional"
    },
    linkedData: {
      enabled: true,
      value: "ontologyInstancesAndOntologies"
    },
    aiOutput: {
      enabled: true,
      value: "artificialIntelligenceGeneratedDescription"
    }
  });

  const toggleRow = (row) => {
    setSelections(prev => ({
      ...prev,
      [row]: { ...prev[row], enabled: !prev[row].enabled }
    }));
  };

  const handleRadioChange = (row, value) => {
    setSelections(prev => ({
      ...prev,
      [row]: {
        ...prev[row],
        value,
        layout: value === "nodeLinkDiagram" ? (prev[row].layout || "ForceAtlas2") : undefined
      }
    }));
  };

  const handleLayoutChange = (e) => {
    setSelections(prev => ({
      ...prev,
      dataVisualization: {
        ...prev.dataVisualization,
        layout: e.target.value
      }
    }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    const result = {};

    if (selections.dataVisualization.enabled) {
      result.dataVisualization = { type: selections.dataVisualization.value };
      if (selections.dataVisualization.value === "nodeLinkDiagram") {
        result.dataVisualization.layout = selections.dataVisualization.layout;
      }
    }
    if (selections.linkedData.enabled) result.linkedData = selections.linkedData.value;
    if (selections.aiOutput.enabled) result.aiOutput = true;

    console.log("Submitted:", result);
    alert("Check console!\n" + JSON.stringify(result, null, 2));
  };

  const layoutOptions = [
    "Fruchterman Reingold", "Contraction", "Force Atlas", "Force Atlas 2",
    "Label Adjust", "Noverlap", "OpenOrd", "Random Layout",
    "Rotate", "Yifan Hu", "Yifan Hu Proportional"
  ];

  const isNodeLinkSelected =
    selections.dataVisualization.enabled &&
    selections.dataVisualization.value === "nodeLinkDiagram";

  return (
    <div className="container">
      <h1>Data Options Selector</h1>
      <form onSubmit={handleSubmit}>

        {/* ROW 1: Data Visualization */}
        <div className="option-row">
          <label className="row-checkbox">
            <input
              type="checkbox"
              checked={selections.dataVisualization.enabled}
              onChange={() => toggleRow("dataVisualization")}
            />
            <span className="checkmark"></span>
          </label>

          <div className="options-wrapper">
            {/* Each radio button gets its own flex line */}
            <div className="radio-line">
              <label className={!selections.dataVisualization.enabled ? "disabled" : ""}>
                <input
                  type="radio"
                  name="dataVisualization"
                  value="opm"
                  checked={selections.dataVisualization.value === "opm"}
                  onChange={() => handleRadioChange("dataVisualization", "opm")}
                  disabled={!selections.dataVisualization.enabled}
                />
                OPM
              </label>
            </div>

            <div className="radio-line">
              <label className={!selections.dataVisualization.enabled ? "disabled" : ""}>
                <input
                  type="radio"
                  name="dataVisualization"
                  value="nodeLinkDiagram"
                  checked={selections.dataVisualization.value === "nodeLinkDiagram"}
                  onChange={() => handleRadioChange("dataVisualization", "nodeLinkDiagram")}
                  disabled={!selections.dataVisualization.enabled}
                />
                 Node-Link Diagram

                {/* Layout dropdown appears right next to the label when selected */}
                {isNodeLinkSelected && (
                  <span className="layout-inline">
                    <strong style={{ marginLeft: "1.5rem", color: "#333" }}>Layout:</strong>
                    <select
                      value={selections.dataVisualization.layout}
                      onChange={handleLayoutChange}
                      className="layout-dropdown-inline"
                    >
                      {layoutOptions.map(opt => (
                        <option key={opt} value={opt}>{opt}</option>
                      ))}
                    </select>
                  </span>
                )}
              </label>
            </div>

            <div className="radio-line">
              <label className={!selections.dataVisualization.enabled ? "disabled" : ""}>
                <input
                  type="radio"
                  name="dataVisualization"
                  value="facetedBrowsing"
                  checked={selections.dataVisualization.value === "facetedBrowsing"}
                  onChange={() => handleRadioChange("dataVisualization", "facetedBrowsing")}
                  disabled={!selections.dataVisualization.enabled}
                />
                 Faceted Browsing
              </label>
            </div>
          </div>
        </div>

        {/* ROW 2: Linked Data */}
        <div className="option-row">
          <label className="row-checkbox">
            <input
              type="checkbox"
              checked={selections.linkedData.enabled}
              onChange={() => toggleRow("linkedData")}
            />
            <span className="checkmark"></span>
          </label>

          <div className="options-wrapper">
            <div className="radio-line">
              <label className={!selections.linkedData.enabled ? "disabled" : ""}>
                <input
                  type="radio"
                  name="linkedData"
                  value="ontologyInstancesAndOntologies"
                  checked={selections.linkedData.value === "ontologyInstancesAndOntologies"}
                  onChange={() => handleRadioChange("linkedData", "ontologyInstancesAndOntologies")}
                  disabled={!selections.linkedData.enabled}
                />
                 Ontology Instances & Ontologies
              </label>
            </div>
            <div className="radio-line">
              <label className={!selections.linkedData.enabled ? "disabled" : ""}>
                <input
                  type="radio"
                  name="linkedData"
                  value="firstDegreeLinkedData"
                  checked={selections.linkedData.value === "firstDegreeLinkedData"}
                  onChange={() => handleRadioChange("linkedData", "firstDegreeLinkedData")}
                  disabled={!selections.linkedData.enabled}
                />
                 1st Degree Linked Data
              </label>
            </div>
          </div>
        </div>

       {/* ROW 3: AI Generated Description — single option, no radio needed */}
  {/* ROW 3: AI Generated Description – single toggle only */}
<div className="option-row">
  <label className="full-row-label">
    <input
      type="checkbox"
      checked={selections.aiOutput.enabled}
      onChange={() => toggleRow("aiOutput")}
    />

    <span className="single-option-text">
      Artificial Intelligence Generated Description
    </span>
  </label>
</div>

        <button type="submit" className="submit-btn">
          Submit Selections
        </button>
      </form>
    </div>
  );
}