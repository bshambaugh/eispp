// src/components/LinkedDataDegreeInput.jsx
import { useState, useEffect } from 'react';

export default function LinkedDataDegreeInput({ value, onChange }) {
  const [inputValue, setInputValue] = useState(value.toString());

  useEffect(() => {
    setInputValue(value.toString());
  }, [value]);

  const handleChange = (e) => {
    const val = e.target.value;
    if (val === '' || /^\d+$/.test(val)) {
      setInputValue(val);
      onChange(val === '' ? 0 : parseInt(val, 10));
    }
  };

  const degreesText = value === 0 ? 'no degrees' : value === 1 ? 'degree' : 'degrees';

  return (
    <label className="linked-data-label">
      Show{' '}
      <input
        type="text"
        inputMode="numeric"
        pattern="[0-9]*"
        value={inputValue}
        onChange={handleChange}
        className="degree-input-inline"
      />{' '}
      {degreesText} for Linked Data
    </label>
  );
}